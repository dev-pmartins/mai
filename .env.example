# Runrun.it (mcp/servers/runrunit) — Configurações → Integrações → API
RUNRUNIT_APP_KEY=
RUNRUNIT_USER_TOKEN=

# GitHub (skills/review) — Settings → Developer settings → Personal access tokens
# Fine-grained token com "Contents: Read-only" e "Pull requests: Read-only" nos repos
# que serão revisados (classic token com escopo "repo" também funciona pra privados).
GITHUB_TOKEN=
